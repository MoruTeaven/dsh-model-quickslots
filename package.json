{
  "name": "@moruteaven/dsh-model-quickslots",
  "version": "0.1.0-dev.5",
  "description": "在 DSH 输入框上方添加一排模型快捷切换按钮，每个按钮对应一套预设配置（提供方 + 模型 + 思考强度）",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-model-selection",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "node esbuild.config.mjs",
    "dev": "node esbuild.config.mjs --watch",
    "prepare": "node esbuild.config.mjs",
    "test": "esbuild src/self-test.ts --bundle --format=esm --platform=node --outfile=lib/self-test.mjs && node lib/self-test.mjs"
  },
  "files": [
    "lib/client.js",
    "lib/index.js",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "author": "抹露茶柒 (MoruTeaven) <me@MoruTeaven.com> (www.MoruTeaven.com)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MoruTeaven/dsh-model-quickslots.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "model",
    "quickswitch",
    "presets"
  ],
  "devDependencies": {
    "@types/react": "~18.3.1",
    "esbuild": "^0.24.0",
    "typescript": "^5.7.0"
  },
  "peerDependencies": {
    "react": "^18.2.0"
  }
}
