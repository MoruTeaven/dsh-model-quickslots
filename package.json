{
  "name": "@moruteaven/dsh-model-quickslots",
  "version": "1.0.1",
  "description": "One-click model preset buttons for the DeepSeek Harness (DSH) composer — switch provider, model and reasoning effort instantly.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-model-selection",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "node esbuild.config.mjs",
    "dev": "node esbuild.config.mjs --watch",
    "prepare": "node esbuild.config.mjs",
    "test": "esbuild src/self-test.ts --bundle --format=esm --platform=node --outfile=lib/self-test.mjs && node lib/self-test.mjs && node test/integration.mjs",
    "test:integration": "node test/integration.mjs"
  },
  "files": [
    "lib/client.js",
    "lib/index.js",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "author": "抹露茶柒 (MoruTeaven) <me@MoruTeaven.com> (www.MoruTeaven.com)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MoruTeaven/dsh-model-quickslots.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "deepseek",
    "plugin",
    "dsh-plugin",
    "model",
    "model-switcher",
    "model-presets",
    "reasoning-effort",
    "quick-switch",
    "composer",
    "web"
  ],
  "devDependencies": {
    "@types/react": "~18.3.1",
    "esbuild": "^0.24.0",
    "typescript": "^5.7.0"
  },
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "homepage": "https://github.com/MoruTeaven/dsh-model-quickslots#readme"
}
